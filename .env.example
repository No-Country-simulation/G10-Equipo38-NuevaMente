# =============================================================================
# NuevaMente — template de variables de entorno (Apéndice A de decisiones_proyecto.md)
# Copiar a .env y completar con valores reales. Solo placeholders aquí (§11.2).
# =============================================================================

# Proveedor de IA
GOOGLE_API_KEY=placeholder
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_VERIFICATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
# Cuotas de embeddings: verificar las cuotas reales de la cuenta para GEMINI_EMBEDDING_MODEL.
# Descomentar y completar conjuntamente las tres variables con enteros positivos.
# RPM: solicitudes/minuto; TPM: tokens/minuto; RPD: solicitudes/día.
# No hay límites universales ni valores de producción predeterminados.
# Sin cuotas explícitas, upload responde 503 y la reconstrucción queda pendiente;
# listado/detalle siguen disponibles, pero las fuentes requieren el índice configurado.
# EMBEDDING_QUOTA_RPM=
# EMBEDDING_QUOTA_TPM=
# EMBEDDING_QUOTA_RPD=
# Visión #30: cuotas del modelo GEMINI_GENERATION_MODEL, verificadas en la cuenta.
# Sin estas cuotas o sin proveedor explícito en MOCK_GEMINI, conserva visión pendiente.
# VISION_QUOTA_RPM=
# VISION_QUOTA_TPM=
# VISION_QUOTA_RPD=
# Gemini 3 admite nivel de pensamiento configurable; dejar sin definir para modelos anteriores.
# GENERATION_THINKING_LEVEL=low
GENERATION_MAX_OUTPUT_TOKENS=8192
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=15
RETRIEVAL_LAMBDA_MULT=0.7
RETRIEVAL_MAX_TOKENS=12000

# Cuotas reales del proyecto de Google AI Studio. Configurar cada triple completa.
# Si generación, visión y verificación usan el mismo modelo, los límites deben coincidir.
# GENERATION_QUOTA_RPM=
# GENERATION_QUOTA_TPM=
# GENERATION_QUOTA_RPD=
# VERIFICATION_QUOTA_RPM=
# VERIFICATION_QUOTA_TPM=
# VERIFICATION_QUOTA_RPD=

# OCI real obligatorio para entrega; credenciales mediante archivo o identidad de instancia
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_COMPARTMENT_ID=placeholder
OCI_REGION=home-region-de-la-tenancy
OCI_CONFIG_FILE=/run/oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_AUTH_TYPE=api_key
# Confirmar manualmente capacidad gratuita disponible; nunca asumir que el trial alcanza.
OCI_ALWAYS_FREE_CONFIRMED=0
OCI_MAX_REQUESTS_PER_MONTH=20000
OCI_MAX_STORAGE_BYTES=1000000000
OCI_TIMEOUT_SECONDS=30

# Solo desarrollo/CI pueden activar el mock explícito
MOCK_OCI=0
APP_ENV=production

# Backend y estado local
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://backend:8000
# Caddy inyecta origen y clave; compartir solo entre proxy y backend. Obligatorio en producción.
TRUSTED_ORIGIN_SECRET=placeholder
DATA_DIR=/app/.data

# Decisiones operativas iniciales
WORKSPACE_RETENTION_DAYS=30
WORKSPACE_MAX_DOCUMENTS=5
WORKSPACE_MAX_GENERATIONS=20
SESSION_MAX_HOURS=24
MAX_GENERATION_ATTEMPTS=3
GENERATION_DEADLINE_SECONDS=300
GLOBAL_HEAVY_JOB_CONCURRENCY=1
MAX_QUEUED_JOBS=5
DEFAULT_OUTPUT_LANGUAGE=es
CHAT_HISTORY_TURNS=8
CHAT_HISTORY_MAX_TOKENS=2000
