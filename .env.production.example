# Compose interpolation ONLY. Copy to a private deployment.env outside the checkout.
# Invoke with --env-file deployment.env and all three -f files in documented order.
NUEVAMENTE_DOMAIN=
NUEVAMENTE_BACKEND_ENV_FILE=/etc/nuevamente/backend.env
NUEVAMENTE_ORIGIN_ENV_FILE=/etc/nuevamente/secrets/origin.env
OCI_CREDENTIALS_DIR=/etc/nuevamente/oci
# Required literal peer IP(s), comma separated, observed from inside backend on the real host.
# No assumed gateway, CIDR, hostname or *. Never use a value copied from a different host.
FORWARDED_ALLOW_IPS=
# No GOOGLE_API_KEY or TRUSTED_ORIGIN_SECRET here. See infra/caddy/README.md.
# Operational limits (WORKSPACE_MAX_DOCUMENTS=5, WORKSPACE_MAX_GENERATIONS=20) belong in NUEVAMENTE_BACKEND_ENV_FILE.
