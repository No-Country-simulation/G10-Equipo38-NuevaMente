# OCI real desde Windows; completar con datos de la consola, sin subir credenciales.
NUEVAMENTE_ENV_FILE=.env.oci.local
APP_ENV=development
MOCK_OCI=0
MOCK_GEMINI=1
GOOGLE_API_KEY=placeholder
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_COMPARTMENT_ID=placeholder
OCI_REGION=home-region-de-la-tenancy
OCI_AUTH_TYPE=api_key
OCI_CONFIG_FILE=C:/Users/TU_USUARIO/.oci/nuevamente/config
OCI_CONFIG_PROFILE=DEFAULT
# Solo poner 1 tras verificar asignación Always Free y consumo agregado disponible.
OCI_ALWAYS_FREE_CONFIRMED=0
OCI_MAX_REQUESTS_PER_MONTH=5000
OCI_MAX_STORAGE_BYTES=1000000000
OCI_TIMEOUT_SECONDS=30
# Directorio dedicado para el overlay Docker; no forma parte de la imagen ni del repo.
OCI_CREDENTIALS_DIR=C:/Users/TU_USUARIO/.oci/nuevamente
